# Disable directory browsing
Options -Indexes

# ----------------------------------------------------------------------
# Protect application files because public/ is intentionally moved to root
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bukti transaksi lama mungkin masih berada di uploads/. Akses HTTP langsung
    # diblokir; file hanya disajikan lewat route Operator terautentikasi.
    RewriteRule ^uploads/(?:bukti_nota|bukti_setoran)(?:/|$) - [F,L,NC]

    # Framework/application source, runtime, development, and project tooling
    # must never be served directly from the web root.
    RewriteRule ^(?:app|vendor|writable|tests|docs|scripts|\.github|\.git)(?:/|$) - [F,L,NC]

    # Sensitive project/configuration files in document root.
    RewriteRule ^(?:\.env(?:\..*)?|\.gitignore|env|README(?:\.md)?|composer\.(?:json|lock)|spark|builds|phpunit\.xml(?:\.dist)?|phpunit\.dist\.xml|LICENSE|preload\.php)$ - [F,L,NC]
</IfModule>

<FilesMatch "^(?:\.env(?:\..*)?|\.gitignore|env|README(?:\.md)?|composer\.(?:json|lock)|spark|builds|phpunit\.xml(?:\.dist)?|phpunit\.dist\.xml|LICENSE|preload\.php)$">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# Rewrite engine
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Jika aplikasi ditempatkan di subfolder, app.baseURL pada .env harus ikut subfolder tersebut.

    # Redirect trailing slashes for non-directories.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve existing static files/directories directly; everything else goes to CI4.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

    # Ensure Authorization header is passed along.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

ServerSignature Off
